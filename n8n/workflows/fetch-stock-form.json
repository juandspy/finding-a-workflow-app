{
  "id": "f0000003-3333-4000-8000-000000000003",
  "name": "fetch-stock-form",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "formTitle": "Fetch stock price",
        "formDescription": "Enter a ticker symbol to fetch the latest quote.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Ticker",
              "fieldType": "text",
              "fieldName": "ticker",
              "placeholder": "AAPL",
              "requiredField": true
            }
          ]
        },
        "options": {}
      },
      "id": "c1c2c3d4-3333-4000-8000-000000000001",
      "name": "Form Trigger",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        -200,
        0
      ],
      "webhookId": "fetch-stock-form"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c1c2c3d4-3333-4000-8000-000000000011",
              "name": "job_name",
              "value": "=fetch-{{ $json.ticker || $json.Ticker }}",
              "type": "string"
            },
            {
              "id": "c1c2c3d4-3333-4000-8000-000000000012",
              "name": "ticker",
              "value": "={{ ($json.ticker || $json.Ticker || '').toString().toUpperCase() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "c1c2c3d4-3333-4000-8000-000000000002",
      "name": "Set ticker",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        20,
        0
      ]
    },
    {
      "parameters": {
        "url": "=https://query1.finance.yahoo.com/v8/finance/chart/{{ $json.ticker }}?interval=1d&range=1d",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "finding-a-workflow-app/n8n (example)"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "c1c2c3d4-3333-4000-8000-000000000003",
      "name": "Fetch quote",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const job = $('Set ticker').first().json;\nconst item = $input.first().json;\n\ntry {\n  const status = item.statusCode ?? 200;\n  if (status >= 400) {\n    throw new Error(`HTTP ${status}`);\n  }\n  const meta = item.chart.result[0].meta;\n  return [{\n    json: {\n      ok: true,\n      exit_code: 0,\n      job_name: job.job_name,\n      ticker: job.ticker,\n      symbol: meta.symbol,\n      price: meta.regularMarketPrice,\n      output: `${meta.symbol}=${meta.regularMarketPrice}`,\n    },\n  }];\n} catch (error) {\n  return [{\n    json: {\n      ok: false,\n      exit_code: 1,\n      job_name: job.job_name,\n      ticker: job.ticker,\n      error: error.message,\n    },\n  }];\n}"
      },
      "id": "c1c2c3d4-3333-4000-8000-000000000004",
      "name": "Parse quote",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1c2c3d4-3333-4000-8000-000000000021",
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c1c2c3d4-3333-4000-8000-000000000005",
      "name": "Failed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"chat_id\": \"{{ $env.TELEGRAM_CHAT_ID }}\",\n  \"text\": \"n8n job FAIL: {{ $json.job_name }}\\nexit_code={{ $json.exit_code }}\\nticker={{ $json.ticker }}\\nerror={{ $json.error }}\",\n  \"disable_web_page_preview\": true\n}",
        "options": {}
      },
      "id": "c1c2c3d4-3333-4000-8000-000000000006",
      "name": "Notify Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        940,
        120
      ]
    },
    {
      "parameters": {
        "operation": "completion",
        "completionTitle": "={{ $json.ok ? $json.output : 'Fetch failed' }}",
        "completionMessage": "={{ $json.ok ? ('Price: ' + $json.price) : $json.error }}",
        "options": {}
      },
      "id": "c1c2c3d4-3333-4000-8000-000000000007",
      "name": "Show result",
      "type": "n8n-nodes-base.form",
      "typeVersion": 1,
      "position": [
        1160,
        0
      ],
      "webhookId": "fetch-stock-form-result"
    }
  ],
