      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const job = $('Set ticker').first().json;\nconst item = $input.first().json;\n\ntry {\n  const status = item.statusCode ?? 200;\n  if (status >= 400) {\n    throw new Error(`HTTP ${status}`);\n  }\n  const meta = item.chart.result[0].meta;\n  return [{\n    json: {\n      ok: true,\n      job_name: job.job_name,\n      ticker: job.ticker,\n      symbol: meta.symbol,\n      price: meta.regularMarketPrice,\n    },\n  }];\n} catch (error) {\n  return [{\n    json: {\n      ok: false,\n      job_name: job.job_name,\n      ticker: job.ticker,\n      error: error.message,\n    },\n  }];\n}"
      },
      "id": "a1b2c3d4-1111-4000-8000-000000000004",
      "name": "Parse quote",
      "type": "n8n-nodes-base.code",
