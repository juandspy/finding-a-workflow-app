# Copy to .env and adjust. Required for credential encryption across restarts.
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string

N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Europe/Madrid

# Used inside workflows (Telegram HTTP nodes read these via $env expressions).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# compose.yaml sets N8N_BLOCK_ENV_ACCESS_IN_NODE=false and whitelists the two vars above.
