# Copy to .env and adjust.
# Same vars as launchd/n8n — read by the notify_telegram activity on failure.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Required for NotionTaskSummaryWorkflow (scripts/run-notion-summary.sh).
# Notion internal integration token with access to the target page/database.
NOTION_TOKEN=
# Same OpenRouter key as dagu/n8n (model: deepseek/deepseek-v4-flash).
OPENROUTER_API_KEY=
